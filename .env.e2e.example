# ==========================================================
# AIF Handoff — E2E-окружение (docker-compose.e2e.yml)
# Copy to `.env.e2e` — used ONLY by `make e2e` / `make e2e-gui` /
# `make e2e-api` / `make e2e-docker` (see scripts/e2e-docker.mjs).
#
# Эти переменные изолируют E2E-стек от dev-окружения (правило в RULES.md):
# порты E2E НЕ пересекаются с dev (3009/5180/3100/3010), поэтому dev-стек
# может работать одновременно с E2E-стеком.
#
# ═══ Host-порты E2E-стека (не должны совпадать с dev) ═══
# API / web / mcp — host-порты (внутри контейнеров порты остаются базовыми).
PORT=3210
WEB_PORT=5280
MCP_PORT=3211

# ═══ Тестовый GitLab (GitLab CE в docker-compose.e2e.yml) ═══
# Версия image (доковая схема тегов: gitlab/gitlab-ce:<version>-ce.0)
GITLAB_VERSION=17.0.2-ce.0
# Host-порт веб-интерфейса/API GitLab (не должен совпадать с dev)
GITLAB_WEB_PORT=8929
# Host-порт SSH GitLab (не должен совпадать с dev)
GITLAB_SSH_PORT=2289
# Первый root-пароль GitLab (детерминированный вход для e2e).
# ВАЖНО: GitLab отклоняет пароли со словарными словами и со значениями
# username/email/name (для root это строка "root"). Если пароль не проходит
# проверку сложности, первичный сиид db/fixtures/production/003_admin.rb падает
# целиком и root-пользователь не создаётся. Поэтому значение должно быть
# «случайным»: без словарных слов и без "root".
GITLAB_ROOT_PASSWORD=Xq7Zt2Lm9Vb4Kp
# Фиксированный personal access token (PAT) для GitLab. Скрипт
# scripts/e2e-docker.mjs создаёт PAT ровно с этим значением (rails console)
# и инжектит его в контейнеры api/agent. Меняйте на свою случайную строку.
GITLAB_TOKEN=aif-e2e-glpat-testtoken123

# ═══ Прочие настройки стенда ═══
# Пароль первого администратора приложения (участники выключены по умолчанию —
# для e2e этого достаточно; включайте participants-режим только при надобности).
# PARTICIPANTS_MODE_ENABLED=false
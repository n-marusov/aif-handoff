{
  "name": "@aif/shared",
  "version": "0.1.0",
  "description": "Shared types, schema, and utilities for AIF Handoff",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --configLoader runner",
    "coverage": "vitest run --coverage",
